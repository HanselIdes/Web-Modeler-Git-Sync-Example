  <bpmn:process id="Process_LoanSecuritization" name="Loan Securitization Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Securitization process initiated">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_LoanPoolSelection" />
    <bpmn:userTask id="Task_LoanPoolSelection" name="Select loan pool for securitization">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_LoanPoolSelection" targetRef="Task_DueDiligence" />
    <bpmn:userTask id="Task_DueDiligence" name="Perform due diligence">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_DueDiligence" targetRef="Gateway_037nlgu" />
    <bpmn:parallelGateway id="Gateway_1">
      <bpmn:incoming>Flow_0hyrikn</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_1" targetRef="Task_StructureSecurities" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_1" targetRef="Task_CreditRating" />
    <bpmn:userTask id="Task_StructureSecurities" name="Structure securities">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CreditRating" name="Obtain credit rating">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_StructureSecurities" targetRef="Gateway_2" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_CreditRating" targetRef="Gateway_2" />
    <bpmn:parallelGateway id="Gateway_2">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_2" targetRef="Task_LegalDocumentation" />
    <bpmn:userTask id="Task_LegalDocumentation" name="Prepare legal documentation">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_LegalDocumentation" targetRef="CallActivity_RegulatoryCompliance" />
    <bpmn:callActivity id="CallActivity_RegulatoryCompliance" name="Regulatory Compliance Reporting">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Process_0e7tlam" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="CallActivity_RegulatoryCompliance" targetRef="Task_Marketing" />
    <bpmn:userTask id="Task_Marketing" name="Market securities to investors">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Marketing" targetRef="Gateway_3" />
    <bpmn:exclusiveGateway id="Gateway_3" name="Sufficient investor interest?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_12" name="Yes" sourceRef="Gateway_3" targetRef="Task_IssuanceAndSale" />
    <bpmn:sequenceFlow id="Flow_13" name="No" sourceRef="Gateway_3" targetRef="Task_Restructure" />
    <bpmn:userTask id="Task_IssuanceAndSale" name="Issue and sell securities">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Restructure" name="Restructure securities">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_IssuanceAndSale" targetRef="Task_PostIssuanceServicing" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Restructure" targetRef="Gateway_037nlgu" />
    <bpmn:userTask id="Task_PostIssuanceServicing" name="Set up post-issuance servicing">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_PostIssuanceServicing" targetRef="EndEvent_1" />
    <bpmn:endEvent id="EndEvent_1" name="Securitization completed">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_037nlgu">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_0hyrikn</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0hyrikn" sourceRef="Gateway_037nlgu" targetRef="Gateway_1" />
  </bpmn:process>
